{
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"target": "es2019",
		"module": "esNext",
		"moduleResolution": "bundler",
		"types": [
			"firefox-webext-browser"
		],
		"strict": true,
		"noImplicitReturns": true,
		"pretty": true,
		"lib": [
			"es2019",
			"dom",
			"dom.iterable"
		]
	},
	"include": [
		"src/**/*",
		"typings/**/*"
	]
}